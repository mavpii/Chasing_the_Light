#. Гаралін, Даеола та Аса мають дістатися до копальні на півночі
#. Гаралін, Даеола та Аса мають дістатися до копальні на півночі
#: Chasing_the_Light/scenarios/05_Aftermath.cfg:215
#: Chasing_the_Light/scenarios/05_Aftermath.cfg:1821
#: Chasing_the_Light/utils/macros.cfg:561
msgid "Haralin, Daeola and Asa have to get to the mine in the north"
msgstr "Гаралін, Даеола та Аса мають дістатися до копальні на півночі"

#. [objective]: condition=lose
#. Загибель Аси
#: Chasing_the_Light/scenarios/05_Aftermath.cfg:233
#: Chasing_the_Light/scenarios/05_Aftermath.cfg:1842
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:1020
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:1987
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:2018
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:2143
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:3290
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:3419
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:4869
#: Chasing_the_Light/scenarios/06_Miscreants.cfg:4900
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:688
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:1623
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:2701
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:2904
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:3031
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:3197
