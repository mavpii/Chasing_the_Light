msgstr ""

#. [redemption]: id=redemption
#: Chasing_the_Light/utils/abilities.cfg:26
msgid "This ability turns any defeated creature with a soul to the side of Light with half HP. Doesn't work on skeletons, corpses and mages of Darkness."
msgstr ""

#. [disguised]: id=disguised
#: Chasing_the_Light/utils/abilities.cfg:33
msgid "disguised"
msgstr ""

#. [cursed]: id=cursed
#: Chasing_the_Light/utils/abilities.cfg:41
msgid "cursed"
msgstr ""

#. [cursed]: id=cursed
#. Цього бійця було проклято Владикою-Лічом Карором. Його ментальне здоров'я та світосприйняття погіршуватимуться з тим, як дія прокляття зростатиме.
#: Chasing_the_Light/utils/abilities.cfg:43
msgid "This unit was cursed by Lord-Lich Caror. His mental health and worldview will deteriorate as the curse intensifies."
msgstr ""

#. [undeath]: id=undeath
#: Chasing_the_Light/utils/abilities.cfg:50
msgid "undeath"
msgstr ""

#. [undeath]: id=undeath
#: Chasing_the_Light/utils/abilities.cfg:51
msgid "The sheer power of this unit forces all fallen warriors on the battlefield to raise and continue fight on its side as undead."
msgstr ""

