#. [event]
#. Старійшино! Бачу групу неопізнаних людей на північному сході від села! І вони схожі на бандюків!
#: Chasing_the_Light/scenarios/01_Overture.cfg:244
msgid "Elder! I see a group of strangers northeast of the village! And they look like bandits!"
msgstr ""

#. [trait]
#: Chasing_the_Light/scenarios/01_Overture.cfg:268
msgid "overconfident"
msgstr ""

#. [trait]
#: Chasing_the_Light/scenarios/01_Overture.cfg:268
msgid "This unit doesn't see the point in using some of their abilities, including nightstalk, because they are too confident in their victory."
msgstr ""

#. [event]
#. Складіть зброю, жалюгідні селюки, і може, ми залишимо вас в живих!
#: Chasing_the_Light/scenarios/01_Overture.cfg:355
msgid "Give up your weapons, miserable peasants, and maybe we'll let you live!"
msgstr ""

#. [event]
#. Та й, що це ти торочиш? Поглянь на себе, одягнений, наче місцевий дурень з ярмарку. Забирайся з нашої землі негайно!
#: Chasing_the_Light/scenarios/01_Overture.cfg:357
msgid "Well-well, what are you babbling about? Look at you, dressed like a local carnival buffoon. Get off our land at once!"
msgstr ""

#. [event]
#. Так, забирайся звідси! Інакше помреш!
#: Chasing_the_Light/scenarios/01_Overture.cfg:359
msgid "Yeah, get out of here! Or you'll die!"
msgstr ""

#. [event]
#. Пф, які неосвідчені йолопи. Що ж, ви самі накликали на себе смерть.
#: Chasing_the_Light/scenarios/01_Overture.cfg:361
msgid "Pfft, what ignorant fools. Well, you brought death on yourselves."
msgstr ""

#. [event]
#. Ми ще подивимося, хто тут йолоп, коли скидатимемо твій труп у помийну яму!
#: Chasing_the_Light/scenarios/01_Overture.cfg:363
msgid "We'll see who's the fool when we dump your corpse in a gutter!"
msgstr ""

#. [event]
#. Батьку, що тут відбувається?!
#: Chasing_the_Light/scenarios/01_Overture.cfg:380
msgid "Dad, what's going on here?!"
msgstr ""

#. [event]
#. Та й, просто купка бандитів з ватажком у шутовській одежі.
#: Chasing_the_Light/scenarios/01_Overture.cfg:385
msgid "Well-well, just a bunch of bandits with a chief in jester's clothes."
msgstr ""

#. [event]
#. Що ж, тоді проженемо їх! Нарешті я використаю мою палицю!
#: Chasing_the_Light/scenarios/01_Overture.cfg:387
msgid "Well, then, let's chase them away! I'm finally going to use my club!"
msgstr ""

#. [event]
#. Еге, тільки не заходь далеко та не роби необачних вчинків.
#: Chasing_the_Light/scenarios/01_Overture.cfg:389
msgid "Aye, just don't go too far from me and do anything rash."
msgstr ""

#. [event]
#. Смакуй мою палицю, бандюго!
#: Chasing_the_Light/scenarios/01_Overture.cfg:407
msgid "Taste my club, you scumbag!"
msgstr ""

