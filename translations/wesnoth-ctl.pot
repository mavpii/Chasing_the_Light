#: Chasing_the_Light/magic/table.lua:15
msgid "Magic Blast"
msgstr ""

#: Chasing_the_Light/magic/table.lua:17
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Ranged 9x2(<span color='#00bbe6'><i>lvl1</i></span>) or 12x3(<span color='#00bbe6'><i>lvl2+</i></span>) impact, <i>magical</i>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:24
msgid "Summon"
msgstr ""

#. Закличте духа природи до себе на допомогу, навіть знаходячись за межами цитаделі.    Для цього закляття використовується <span color='#FFD700'><i >золото</i></span> та <span color='#00bbe6'><i>досвід</i></span>
#: Chasing_the_Light/magic/table.lua:27
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Summon the spirit of nature to your aid, even when outside the keep.\n           This spell uses <span color='#FFD700'><i>gold</i></span> and <span color='#00bbe6'><i>experience</i></span>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:40
msgid "Shield"
msgstr ""

#: Chasing_the_Light/magic/table.lua:42
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>8xp</i></span> to gain <i>+20% dodge chance</i> until the start of your next turn or until cancelled."
msgstr ""

#: Chasing_the_Light/magic/table.lua:52
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>12xp</i></span> and <span color='#c06a61'><i>your attack</i></span> to <i>petrify</i> yourself and adjacent units until the start of your next turn."
msgstr ""

#: Chasing_the_Light/magic/table.lua:60
msgid "Panacea"
msgstr ""

#: Chasing_the_Light/magic/table.lua:62
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>12xp</i></span> to fully heal the lowest-health adjacent ally, and increase\n           its attacks, strikes, and damage by its level. <span color='#bb0000'><b>Next turn, it dies.</b></span>"
msgstr ""

#: Chasing_the_Light/magic/table.lua:70
msgid "Chill Touch"
msgstr ""

#: Chasing_the_Light/magic/table.lua:72
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Melee 6x3 cold, <i>slows</i>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:79
msgid "Levitate"
msgstr ""

#: Chasing_the_Light/magic/table.lua:81
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>8xp</i></span> to gain the <i>skirmisher</i> ability and <i>50%</i> defense on all terrain.\n           Lasts until the start of your next turn or until cancelled."
msgstr ""

#: Chasing_the_Light/magic/table.lua:89
msgid "Mnemonic"
msgstr ""

#: Chasing_the_Light/magic/table.lua:91
msgid "<span color='#a9a150'><i><b>Passive:</b></i></span> Whenever an adjacent ally gains xp, you gain the same amount of xp."
msgstr ""

#: Chasing_the_Light/magic/table.lua:98
msgid "Find Familiar"
msgstr ""

#: Chasing_the_Light/magic/table.lua:100
msgid "<span color='#a9a150'><i><b>Passive:</b></i></span> Begin each scenario with your trusty pet raven.\n               Your familiar’s level and xp persist across scenarios, but reset if it dies."
msgstr ""

#: Chasing_the_Light/magic/table.lua:107
msgid "Bend Nature"
msgstr ""

#. Керуйте самою природою, створюючи та направляючи її елементи — землю, воду, лаву та повітря.      Для цього закляття використовується <span color='#00bbe6'><i>досвід</i></span> та <span color='#FFD700'><i >золото</i></span>
#: Chasing_the_Light/magic/table.lua:110
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Control nature itself by creating and bending its elements — earth, water, lava, and air.\n           This spell uses <span color='#00bbe6'><i>experience</i></span>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:122
msgid "Fireball"
msgstr ""

#: Chasing_the_Light/magic/table.lua:124
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Ranged 8x4(<span color='#00bbe6'><i>lvl2</i></span>) or 12x4(<span color='#00bbe6'><i>lvl3+</i></span>) fire, <i>magical</i>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:131
msgid "Glamour"
msgstr ""

#: Chasing_the_Light/magic/table.lua:133
msgid "<span color='#a9a150'><i><b>Passive:</b></i></span> Gain the <i>leadership</i> ability."
msgstr ""

#: Chasing_the_Light/magic/table.lua:140
msgid "Siphon"
msgstr ""

#: Chasing_the_Light/magic/table.lua:142
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Ranged 8x4 arcane, <i>magical</i>, <i>drains</i>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:149
msgid "Blizzard"
msgstr ""

#: Chasing_the_Light/magic/table.lua:151
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>16xp</i></span> and <span color='#c06a61'><i>your attack</i></span> to slow enemy units and freeze terrain in a 3-hex radius."
msgstr ""

#: Chasing_the_Light/magic/table.lua:159
msgid "Counterspell"
msgstr ""

#: Chasing_the_Light/magic/table.lua:161
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>16xp</i></span> to <i>disallow magical attacks</i> in a 3-hex radius, until cancelled.\n           Prevents spellcasting, but not passive skills."
msgstr ""

#: Chasing_the_Light/magic/table.lua:169
msgid "Polymorph"
msgstr ""

#: Chasing_the_Light/magic/table.lua:171
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Transform into a lizard (<span color='#00bbe6'><i>8xp</i></span>), bear (<span color='#00bbe6'><i>12xp</i></span>), yeti (<span color='#00bbe6'><i>20xp</i></span>), or orc (<span color='#00bbe6'><i>32xp</i></span>). Lasts until cancelled.\n            Replaces Haralin’s attacks, spells, and passives, but does not affect hitpoints."
msgstr ""

#: Chasing_the_Light/magic/table.lua:183
msgid "Dancing Daggers"
msgstr ""

#: Chasing_the_Light/magic/table.lua:185
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Ranged 5x8 blade, <i>backstab</i>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:192
msgid "Enthrall"
msgstr ""

#: Chasing_the_Light/magic/table.lua:194
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>48xp</i></span> and <span color='#c06a61'><i>your attack</i></span> to magically disguise yourself as an awe-inspiring drake,\n           reducing accuracy and dodge by 10% for enemies in a 2 hex radius."
msgstr ""

#: Chasing_the_Light/magic/table.lua:202
msgid "Animate Fire"
msgstr ""

#: Chasing_the_Light/magic/table.lua:204
msgid "<span color='#a9a150'><i><b>Passive:</b></i></span> Learn to recruit <i>Fire Guardians</i>. Fire Guardians gain +100% damage and XP\n               while adjacent to you, but dissipate at the end of each scenario."
msgstr ""

#: Chasing_the_Light/magic/table.lua:211
msgid "Contingency"
msgstr ""

#: Chasing_the_Light/magic/table.lua:213
msgid "<span color='#a9a150'><i><b>Passive:</b></i></span> Whenever one of your soldiers dies, they are instead safely returned to your recall list."
msgstr ""

#: Chasing_the_Light/magic/table.lua:220
msgid "Chain Lightning"
msgstr ""

#: Chasing_the_Light/magic/table.lua:222
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Ranged 9x4(<span color='#00bbe6'><i>lvl3</i></span>) or 14x4(<span color='#00bbe6'><i>lvl4</i></span>) fire, <i>magical</i>. If this attack kills an enemy, you may attack again."
msgstr ""

#: Chasing_the_Light/magic/table.lua:229
msgid "Time Dilation"
msgstr ""

#: Chasing_the_Light/magic/table.lua:231
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>48xp</i></span> to grant yourself and all allies double movement and a second attack this turn.\n           When this turn ends, affected units become slowed."
msgstr ""

#: Chasing_the_Light/magic/table.lua:239
msgid "Cataclysm"
msgstr ""

#: Chasing_the_Light/magic/table.lua:241
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>99xp</i></span> and <span color='#c06a61'><i>your attack</i></span> to injure everyone in a 4-hex radius for 40%-90%\n           of their current HP. Melts snow, burns forest, and levels castles/villages."
msgstr ""

#: Chasing_the_Light/magic/table.lua:249
msgid "Magic Missile"
msgstr ""

#: Chasing_the_Light/magic/table.lua:251
msgid "<span color='#ad6a61'><i><b>Attack:</b></i></span> Ranged 7x3(<span color='#00bbe6'><i>lvl1</i></span>) or 10x3(<span color='#00bbe6'><i>lvl2+</i></span>) fire, <i>magical</i>."
msgstr ""

#: Chasing_the_Light/magic/table.lua:258
msgid "Lightbeam"
msgstr ""

#. <span color='#6ca364'><i><b>Spell:</b></i></span> Використайте <span color='#00bbe6'><i>8xp</i></span>, щоб атакувати ворога дальньою містичною атакою <b>9x3</b>. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>6 клітинок.</i>
#: Chasing_the_Light/magic/table.lua:261
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>8xp</i></span> to attack the enemy with a <b>9x3</b> ranged arcane attack. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>6 hexes.</i>"
msgstr ""

#: Chasing_the_Light/magic/table.lua:269
msgid "Swap"
msgstr ""

#. "<span color='#6ca364'><i><b>Spell:</b></i></span> Використайте <span color='#00bbe6'><i>8xp</i></span>, щоб миттєво обмінятися місцями з будь-яким юнітом. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>4 клітинок.</i>",
#: Chasing_the_Light/magic/table.lua:272
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>8xp</i></span> to instantly swap places with any unit. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>4 hexes.</i>"
msgstr ""

#: Chasing_the_Light/magic/table.lua:280
msgid "Distant Heal"
msgstr ""

#. <span color='#6ca364'><i><b>Spell:</b></i></span> Використайте <span color='#00bbe6'><i>6xp</i></span>, щоб вилікувати себе або дружнього юніта на +8 ОЗ. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>7 клітинок.</i>",
#: Chasing_the_Light/magic/table.lua:283
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>6xp</i></span> to heal yourself or a friendly unit for +8 HP. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>7 hexes.</i>"
msgstr ""

#: Chasing_the_Light/magic/table.lua:291
msgid "Holy Ward"
msgstr ""

#. "<span color='#6ca364'><i><b>Spell:</b></i></span> Використайте <span color='#00bbe6'><i>10xp</i></span>, щоб на кілька ходів розмістити на мапі <i>Оберіг</i>.\n          Кожного ходу він завдаватиме навколишнім мерцям <b>10</b> містичної шкоди. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>2 клітинки.</i>",
#: Chasing_the_Light/magic/table.lua:294
msgid "<span color='#6ca364'><i><b>Spell:</b></i></span> Spend <span color='#00bbe6'><i>10xp</i></span> to place <i>Ward</i> on the map for a few turns.\n           Each turn, it will deal <b>20</b> arcane damage to the surrounding undead. \n<span color='#ad6a61'><i><b>Radius:</b></i></span> <i>2 hexes.</i>"
msgstr ""

#: Chasing_the_Light/magic/table.lua:302
msgid "Relocate"
