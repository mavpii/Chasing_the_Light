msgstr ""

#. [part]
#. Під землею було неможливо визначити скільки днів минуло з початку їхніх блукань, та й ніхто навіть не намагався рахувати, всі просто сподівалися, що вони встигнуть; встигнуть дістатися до Скархейну до того, як його захоплять мерці. Тож просто через деякий час Гаралін та інші нарешті дісталися до якихось людських шахт, де вони знайшли велику кількість мертвих тіл, а також трохи далі величезну браму, крізь щілини якої лилося яскраве сонячне світло...
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:86
msgid "It was impossible to tell how many days had passed underground since their wanderings began, so everyone just hoped they would make it; that they would make it to Scarhane before the undead seized it. So after a while, Haralin and the others finally reached some human mines, where they found a large number of dead bodies, and a little further on a huge gate with bright sunlight pouring through the cracks..."
msgstr ""

#. [side]: id=Edvar, type=Royal Warrior
#. Захисники Скархейну
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:149
msgid "Defenders of Scarhane"
msgstr ""

#. [side]: id=faisim, type=Wesfolk Princess, gender=female
#. Війська Ленвана
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:169
msgid "Lenvan's Forces"
msgstr ""

#. [side]: id=s7_necromancer, type=Dark Sorcerer
#. Західняцькі некроманти
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:198
msgid "Wesfolk Necromancers"
msgstr ""

#. [side]: id=s7_death_knight, type=Death Knight
#. Західняцька армія
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:220
msgid "Wesfolk Army"
msgstr ""

#. [side]: id=s7_bone_knight, type=Pyre Wight
#: Chasing_the_Light/scenarios/07_Scarhane.cfg:236
